diff --git a/test/upload.test.js b/test/upload.test.js
new file mode 100644
index 0000000..5439b31
--- /dev/null
+++ b/test/upload.test.js
@@ -0,0 +1,119 @@
+/**
+ * upload: файл только из uploadDirs, нужного типа и размера; цель — <input type=file>
+ * или кнопка, открывающая выбор файла; скрытый input виден через метку или кнопку,
+ * после загрузки в снимке видно имя файла.
+ *
+ *   node test/upload.test.js
+ */
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { chromium } = require('playwright-core');
+const { hands, validate, BadCommand } = require('../hands.js');
+
+// Три способа прикрепить файл: обычный input, скрытый input с меткой, скрытый input с кнопкой рядом.
+// Обработчик change пишет имя файла в текст страницы. Последние два поля показывать нельзя.
+const HTML = `
+<body style="margin:0">
+  <p>Форма отклика</p>
+  <input type="file" aria-label="Обычный файл" class="pick">
+  <label for="cv">Резюме</label><input id="cv" type="file" class="pick" style="display:none">
+  <div><input id="letter" type="file" class="pick" hidden><button onclick="document.getElementById('letter').click()">Прикрепить письмо</button></div>
+  <input type="file" style="display:none">
+  <input type="text" aria-label="Скрытое поле" style="display:none">
+  <p id="log"></p>
+  <script>
+    for (const i of document.querySelectorAll('.pick')) i.addEventListener('change', () => {
+      document.getElementById('log').textContent += ' прикреплён:' + i.files[0].name + ':' + i.files[0].size + ':' + i.files[0].type;
+    });
+  </script>
+</body>`;
+
+(async () => {
+  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), 'meatsuit-up-'));
+  const up = path.join(tmp, 'up');
+  const evil = path.join(tmp, 'up-evil'); // общий префикс с up
+  const other = path.join(tmp, 'other');
+  for (const d of [up, evil, other]) fs.mkdirSync(d);
+  const pdf = path.join(up, 'cv.pdf');
+  const docx = path.join(up, 'letter.docx');
+  fs.writeFileSync(pdf, '%PDF-1.4 тест');
+  fs.writeFileSync(docx, 'docx');
+  fs.writeFileSync(path.join(up, 'notes.txt'), 'txt');
+  fs.writeFileSync(path.join(up, 'big.pdf'), Buffer.alloc(10 * 1024 * 1024 + 1));
+  fs.writeFileSync(path.join(evil, 'x.pdf'), 'x');
+  fs.writeFileSync(path.join(other, 'x.pdf'), 'x');
+  fs.symlinkSync(path.join(other, 'x.pdf'), path.join(up, 'link.pdf')); // симлинк наружу
+  const logFile = path.join(tmp, 'log.jsonl');
+
+  // Поля проверяются до выполнения; без uploadDirs команда не разрешена.
+  const ok = { cmd: 'upload', id: 1, gen: 1, file: pdf };
+  assert.throws(() => validate(ok), BadCommand, 'без uploadDirs');
+  assert.throws(() => validate({ ...ok, id: undefined }, [], [up]), BadCommand);
+  assert.throws(() => validate({ ...ok, file: 'cv.pdf' }, [], [up]), BadCommand, 'относительный путь');
+  assert.throws(() => validate({ ...ok, file: path.join(up, 'notes.txt') }, [], [up]), BadCommand, 'чужое расширение');
+  validate(ok, [], [up]);
+
+  const browser = await chromium.launch();
+  const page = await browser.newPage({ viewport: { width: 800, height: 600 } });
+  await page.setContent(HTML);
+  const logged = () => page.evaluate(() => document.getElementById('log').textContent);
+
+  // Глаза: скрытый input виден через метку или кнопку рядом, с inputType: 'file'; без них и скрытое текстовое поле — нет.
+  const h = hands(page, { uploadDirs: [up], logFile });
+  const s0 = await h.see();
+  const files = s0.elements.filter((e) => e.inputType === 'file');
+  assert.deepEqual(files.map((e) => e.name), ['Обычный файл', 'Резюме', 'Прикрепить письмо']);
+  assert.equal(s0.elements.length, 4, 'фильтр видимости для остальных элементов сломан'); // три input и кнопка
+  assert.ok(files.every((e) => e.inView && e.value === ''));
+
+  // Без uploadDirs — BadCommand.
+  await assert.rejects(hands(page).act({ cmd: 'upload', id: files[0].id, gen: s0.gen, file: pdf }), BadCommand);
+
+  // Отказы до выполнения: вне uploadDirs (другой каталог, `..`, соседний каталог с общим префиксом, симлинк наружу), размер, нет файла.
+  const rejects = (file, label) => assert.rejects(h.act({ cmd: 'upload', id: files[0].id, gen: s0.gen, file }), BadCommand, label);
+  await rejects(path.join(other, 'x.pdf'), 'другой каталог');
+  await rejects(`${up}/../other/x.pdf`, '..');
+  await rejects(path.join(evil, 'x.pdf'), 'соседний каталог с общим префиксом');
+  await rejects(path.join(up, 'link.pdf'), 'симлинк наружу');
+  await rejects(path.join(up, 'big.pdf'), 'больше 10 МБ');
+  await rejects(path.join(up, 'none.pdf'), 'файла нет');
+  assert.equal(await logged(), '', 'отказ что-то загрузил');
+
+  // dryRun: не выполняется, только журнал; плохой путь отклоняется и на репетиции.
+  const dry = hands(page, { dryRun: true, uploadDirs: [up], logFile });
+  const d0 = await dry.see();
+  const cvId = d0.elements.find((e) => e.name === 'Резюме').id;
+  assert.deepEqual(await dry.act({ cmd: 'upload', id: cvId, gen: d0.gen, file: pdf }), { dryRun: true, changed: false });
+  await assert.rejects(dry.act({ cmd: 'upload', id: cvId, gen: d0.gen, file: path.join(other, 'x.pdf') }), BadCommand);
+  assert.equal(await logged(), '', 'dryRun загрузил');
+
+  // Обычный input: файл встаёт без клика; в снимке value с именем файла и имя в тексте.
+  const by = (snap, name) => snap.elements.find((e) => e.inputType === 'file' && e.name === name);
+  const s1 = await h.see();
+  const r1 = await h.act({ cmd: 'upload', id: by(s1, 'Обычный файл').id, gen: s1.gen, file: pdf });
+  assert.equal(r1.changed, true);
+  assert.ok(r1.text.includes('прикреплён:cv.pdf:17:application/pdf'), r1.text);
+  assert.equal(by(r1, 'Обычный файл').value, 'C:\\fakepath\\cv.pdf');
+
+  // Скрытый input с меткой: цель — сам input.
+  const r2 = await h.act({ cmd: 'upload', id: by(r1, 'Резюме').id, gen: r1.gen, file: docx });
+  assert.ok(r2.text.includes('прикреплён:letter.docx:4:application/vnd.openxmlformats-officedocument.wordprocessingml.document'), r2.text);
+  assert.equal(by(r2, 'Резюме').value, 'C:\\fakepath\\letter.docx');
+
+  // Кнопка, открывающая выбор файла: человеческий клик, выбор перехвачен.
+  const btn = r2.elements.find((e) => e.role === 'button' && e.name === 'Прикрепить письмо');
+  const r3 = await h.act({ cmd: 'upload', id: btn.id, gen: r2.gen, file: pdf });
+  assert.ok(r3.text.includes('прикреплён:cv.pdf:17:application/pdf прикреплён:letter.docx'), r3.text);
+  assert.equal(by(r3, 'Прикрепить письмо').value, 'C:\\fakepath\\cv.pdf');
+  assert.equal((await logged()).split('прикреплён').length - 1, 3, 'лишняя загрузка');
+
+  // Журнал: репетиция и три настоящих.
+  const lines = fs.readFileSync(logFile, 'utf8').trim().split('\n').map(JSON.parse).filter((l) => l.cmd.cmd === 'upload');
+  assert.equal(lines.filter((l) => l.result === 'dry-run').length, 1);
+  assert.equal(lines.filter((l) => l.result === 'ok').length, 3);
+
+  await browser.close();
+  console.log('upload.test: ok');
+})().catch((e) => { console.error(e); process.exit(1); });

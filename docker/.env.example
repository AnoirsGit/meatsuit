# Файл деплоя зеркала meatsuit. В нём только то, что принадлежит серверу: порты, браузер, пароли зеркала,
# профиль браузера. Настройки ботов (лимиты площадок, папки для загрузки, каталог состояния) сюда не входят:
# их передаёт вызывающий в connect()/task().
#
# Создать:   npm run init     — пишет docker/.env (или файл из MEATSUIT_CONFIG) с правами 0600 и случайными
#                               паролями; если файл уже есть, ничего не трогает. В git файл не попадает.
# Править:   npm run config   — страница на 127.0.0.1 с подсказками и проверкой; или руками.
# Применить: docker/up.sh   (= docker compose --env-file <файл> up -d; compose читает файл только при up).
#
# Значения без пробелов, кавычек и знака $: файл читает и docker compose, и shell-скрипт verify.sh.

# Пароли зеркала Neko: участник и админ (кто какой ввёл, тем и вошёл). Длинные (от 12 знаков), разные.
NEKO_PASSWORD=
NEKO_ADMIN_PASSWORD=

# Где слушает зеркало на хосте. 127.0.0.1 — только с этой машины (по умолчанию).
# На сервере поставьте сюда адрес tailnet хоста (100.x.y.z): наружу порт не открывается никогда, 0.0.0.0 нельзя.
NEKO_BIND_IP=127.0.0.1
NEKO_PORT=8080
# Адрес, по которому клиент WebRTC достаёт видео: тот же, под которым вы открываете зеркало.
NEKO_WEBRTC_IP=127.0.0.1
# Порт замороженного HTTP-сервиса (профиль api) на том же адресе. Библиотеке он не нужен.
MEATSUIT_API_PORT=8787

# Браузер в зеркале: chrome (Google Chrome, по умолчанию) или brave. Профиль у каждого свой (тома
# meatsuit_profile и meatsuit_brave_profile): после смены входить на сайты заново.
MEATSUIT_BROWSER=chrome
# Версия образа Neko (тег ghcr.io/m1k1o/neko/<браузер>).
NEKO_TAG=3.1.6
# Папка профиля браузера (куки, входы) на хосте. Пусто — том Docker. Путь — абсолютный; хозяином (uid 1000) её
# делает сам compose. Папка — для текущего браузера: меняете браузер — меняйте и папку.
MEATSUIT_PROFILE_DIR=

# Часовой пояс браузера (имя IANA). Он должен совпадать с поясом страны, из которой выходит трафик.
MEATSUIT_TZ=UTC

# Картинка и ресурсы. Видео кодируется на процессоре: на слабом сервере уменьшайте.
NEKO_SCREEN=1280x720@30
NEKO_MEM=3g
NEKO_CPUS=2   # 0 — без ограничения: на части хостингов (например OpenVZ) квота процессора не принимается
#   и контейнер не стартует с ошибкой «cpu.cfs_quota_us: invalid argument». То же у LIFE_CPUS и SERVER_CPUS (по умолчанию 0.5).

# Необязательно, страница конфига их не показывает и не меняет (в файле они сохраняются как есть):
#   LIFE_CPUS, SERVER_CPUS — потолки процессора прогрева и HTTP-сервиса;
#   BRAVE_EXTRA_FLAGS — дополнительные флаги Brave (без пробелов внутри значений);
#   LIFE_CONFIG — конфиг прогрева внутри контейнера (по умолчанию /app/profiles/life.json);
#   TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID — уведомления замороженного HTTP-сервиса;
#   MEATSUIT_EGRESS=tailscale — выход через Tailscale: docker/up.sh добавит docker-compose.egress.yml и профиль egress;
#   TS_AUTHKEY, TS_HOSTNAME, TS_EXTRA_ARGS — настройки этого Tailscale (docker/README.md). TS_AUTHKEY можно не задавать:
#   ссылка для входа будет в docker/up.sh logs tailscale. TS_EXTRA_ARGS — в двойных кавычках (в нём пробел), например
#   TS_EXTRA_ARGS="--exit-node=<IP узла> --exit-node-allow-lan-access=true" (без доступа к LAN зеркало не открывается).

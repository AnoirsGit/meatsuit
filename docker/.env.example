# Скопируйте в docker/.env и заполните. Файл .env в git не попадает.

# Пароли зеркала Neko: участник и админ (кто какой ввёл, тем и вошёл). Длинные, разные.
NEKO_PASSWORD=
NEKO_ADMIN_PASSWORD=

# Где слушает зеркало на хосте. 127.0.0.1 — только с этой машины (по умолчанию).
# На сервере поставьте сюда адрес tailnet хоста (100.x.y.z): наружу порт не открывается никогда.
NEKO_BIND_IP=127.0.0.1
NEKO_PORT=8080
# Адрес, по которому клиент WebRTC достаёт видео: тот же, под которым вы открываете зеркало.
NEKO_WEBRTC_IP=127.0.0.1

# Картинка и ресурсы. Видео кодируется на процессоре: на слабом сервере уменьшайте.
NEKO_SCREEN=1280x720@30
NEKO_MEM=3g
NEKO_CPUS=2

# Дополнительные флаги Brave (без пробелов внутри значений).
BRAVE_EXTRA_FLAGS=

# Автопрогрев: конфиг внутри контейнера.
LIFE_CONFIG=/app/profiles/life.json
